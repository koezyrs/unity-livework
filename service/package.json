{
  "name": "unity-livework-service",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "esbuild upstream/websockethandler.ts --bundle --platform=node --format=cjs --outfile=generated/signaling.cjs && node scripts/bundle-service.mjs && node scripts/bundle-renderstreaming.mjs",
    "start": "node server.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:ui": "node test/ui.mjs",
    "brand": "node scripts/export-brand.mjs && node scripts/export-connection-icons.mjs",
    "check:bundle": "node scripts/bundle-service.mjs --check && node scripts/bundle-renderstreaming.mjs --check"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.25.12"
  }
}
